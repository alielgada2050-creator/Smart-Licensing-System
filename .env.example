# Local development template. Copy to .env and keep it out of version control.
DATABASE_URL=

# Google OAuth web client. The client secret stays on the server.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_MASTER_ADMIN_EMAIL=alielgada5@gmail.com

# Session signing key: generate a unique random value of at least 32 characters.
SESSION_SIGNING_KEY=
AUTH_SESSION_TTL_SECONDS=28800
# false is only for localhost HTTP development; use true behind HTTPS in deployment.
AUTH_COOKIE_SECURE=false

# Google Drive API - not used by sign-in; configure separately when Drive integration is implemented.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# User-selected identity provider.
AUTH_PROVIDER=google

# Restrict this to the actual web application origins before deployment.
CORS_ALLOWED_ORIGINS=http://localhost:8000
